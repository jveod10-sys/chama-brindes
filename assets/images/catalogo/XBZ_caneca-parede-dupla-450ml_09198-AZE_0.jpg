<script>
	function aparecemenu(){
		$(".ul_menu_mobile").slideToggle();
	}
	
	$(document).ready(function(){
		// Mostra menu Mobile
		$('#menu_mobile').bind('click',function(){
			switch($('.menu_mobile').css('display')){
				case 'none':
					$('.menu_responsivo').css('width','100%');
					$('.menu_mobile').slideToggle();
					break;
				case 'block':
					$('.menu_mobile').slideToggle();
					setTimeout( function(){ $('.menu_responsivo').css('width','auto'); },500);
					break;
			}
		});
		
		$(".icon_busca_mobile").click( function(){
			
			switch($("#busca_mobile").css('display')){
				case 'none':
					$('.menu_responsivo').css('width','100%');
					//$("#busca_mobile").slideToggle();
					$("#busca_mobile").animate({width:'toggle'});
					break;
				case 'block':
					//$("#busca_mobile").slideToggle();
					$("#busca_mobile").animate({width:'toggle'});
					setTimeout( function(){ $('.menu_responsivo').css('width','auto'); },500);
					break;
			}
			
		});
	});

</script>

